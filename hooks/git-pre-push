#!/usr/bin/env bash
# Author: [YOUR NAME]
# Date: 2026-10-13
# Scope: git pre-push hook. Blocks direct pushes to protected branches and runs an optional check.
# Ticket: none (Arbiter is not Jira tracked)
# ChangeLog:
#   2026-10-13  Created.
#
# Install: copy or symlink to <repo>/.git/hooks/pre-push (or use core.hooksPath).
# Env:
#   ARBITER_PROTECTED_BRANCHES  space separated branch names (default: "main master")
#   ARBITER_ALLOW_PROTECTED_PUSH  set to 1 to allow a protected push once
#   ARBITER_PRE_PUSH_CMD        optional command run before every push (for example a test
#                               or review script); a non zero exit blocks the push
# git passes the remote name and URL as $1 and $2, and one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

set -uo pipefail

PROTECTED="${ARBITER_PROTECTED_BRANCHES:-main master}"

if [ "${ARBITER_ALLOW_PROTECTED_PUSH:-0}" != "1" ]; then
    while read -r _local_ref _local_sha remote_ref _remote_sha; do
        [ -z "${remote_ref:-}" ] && continue
        branch="${remote_ref#refs/heads/}"
        for blocked in $PROTECTED; do
            if [ "$branch" = "$blocked" ]; then
                echo "pre-push: direct push to '$branch' is blocked. Open a pull request instead." >&2
                echo "pre-push: set ARBITER_ALLOW_PROTECTED_PUSH=1 to override once." >&2
                exit 1
            fi
        done
    done
else
    cat >/dev/null
fi

if [ -n "${ARBITER_PRE_PUSH_CMD:-}" ]; then
    if ! bash -c "$ARBITER_PRE_PUSH_CMD"; then
        echo "pre-push: ARBITER_PRE_PUSH_CMD failed, push blocked." >&2
        exit 1
    fi
fi

exit 0
