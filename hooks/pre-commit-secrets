#!/usr/bin/env bash
# pre-commit-secrets — blocks commits containing known secret token patterns.
# Install: copy or symlink to .git/hooks/pre-commit in any repo.
# Canonical copy lives in Arbiter/hooks/; install.sh installs it.
set -euo pipefail

# Regex patterns that match real token values (minimum length prevents
# false positives on the pattern strings themselves in this file).
PATTERNS=(
    "ATATT[A-Za-z0-9_/+]{30,}"
    "xoxb-[A-Za-z0-9-]{20,}"
    "xoxp-[A-Za-z0-9-]{20,}"
    "sk-ant-api03-[A-Za-z0-9_-]{20,}"
    "dapi[0-9a-f]{32}"
    "github_pat_[A-Za-z0-9_]{40,}"
    "gh[pousr]_[A-Za-z0-9]{36,}"
    "sk-[A-Za-z0-9]{20,}"
    "AccountKey=[A-Za-z0-9+/=]{40,}"
    "-----BEGIN [A-Z ]*PRIVATE KEY-----"
)

found=0

for pattern in "${PATTERNS[@]}"; do
    matches=$(git diff --cached --unified=0 | grep "^+" | grep -v "^+++" | grep -E "$pattern" || true)
    if [ -n "$matches" ]; then
        if [ "$found" -eq 0 ]; then
            echo ""
            echo "COMMIT BLOCKED — secret token pattern detected in staged changes."
            echo "Store credentials in environment variables or a secrets manager, never in files."
            echo ""
        fi
        echo "  Pattern: $pattern"
        echo "$matches" | head -3 | sed 's/^/    /'
        echo ""
        found=1
    fi
done

if [ "$found" -ne 0 ]; then
    echo "If this is a false positive, use: git commit --no-verify (requires explicit override)"
    exit 1
fi

exit 0
